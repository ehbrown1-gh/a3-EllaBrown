# MongoDB connection string
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/slingshot

# Use a long random string in production
SESSION_SECRET=replace-with-a-long-random-secret

# GitHub OAuth App credentials
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# Must exactly match the callback URL configured in GitHub
GITHUB_CALLBACK_URL=http://localhost:3000/auth/github/callback

# Set to production when deployed behind HTTPS
NODE_ENV=development
PORT=3000
